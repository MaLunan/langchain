# Moonshot / Kimi
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.5

# TTS
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 可灵 AI（数字人口播）
KLING_ACCESS_KEY_ID=
KLING_ACCESS_KEY_SECRET=
KLING_API_BASE_URL=https://api-beijing.klingai.com
# 数字人口播默认参数（可选）
# KLING_AVATAR_MODE=std       # std（标准）或 pro（高质量，更慢）
# KLING_AVATAR_PROMPT=        # 正向提示词，定义动作/情绪/运镜，不超过 2500 字符
# 调试可灵鉴权时临时打开，会在后端控制台打印完整 JWT。排查后请关闭。
KLING_PRINT_JWT=0
# 调试可灵请求时临时打开，会打印目标 URL、Authorization 是否携带、响应状态。
KLING_DEBUG_HTTP=0

KLING_AVATAR_MODE=std
KLING_AVATAR_PROMPT=保持自然微笑，轻微点头，镜头保持固定
# 百度云数字人（晓灵平台）- 与可灵二选一或同时配置，前端可切换
BAIDU_DH_APP_ID=
BAIDU_DH_APP_KEY=
BAIDU_DH_API_BASE_URL=https://open.xiling.baidu.com

# 腾讯云 COS - 百度云数字人需要公开 URL，音频/图片先上传到 COS 再传给百度云
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing

# 工作流状态存储。默认不配置时使用内存；要防止重启丢失，请启用 MySQL。
# WORKFLOW_STORE_BACKEND=mysql
# WORKFLOW_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/digital_human_workflow
# WORKFLOW_MYSQL_TABLE=workflow_sessions
WORKFLOW_STORE_BACKEND=mysql
WORKFLOW_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/digital_human_workflow
WORKFLOW_MYSQL_TABLE=workflow_sessions