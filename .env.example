# 从 https://platform.moonshot.cn/console/api-keys 创建，复制为 .env 后填写
MOONSHOT_API_KEY='sk-gR0kw3JRE7P21cghpXoFJjqg6VxoSZFD4xgj7Z8QISh2V88h'

# 可选：模型 ID，默认 kimi-k2.5（以控制台文档为准）
# MOONSHOT_MODEL=kimi-k2.5

# 可选：采样温度。kimi-k2.5 等模型在 Moonshot 侧通常只允许 1；旧版 moonshot-v1-* 可试 0.2
# MOONSHOT_TEMPERATURE=1

# 可选：国内下载嵌入模型慢时，可尝试 Hugging Face 镜像（自行评估来源可信度）
# HF_ENDPOINT=https://hf-mirror.com

# 本地 HTTP 服务（server.py）跨域：多个前端域名用英文逗号分隔；默认 * 仅建议本机调试
# CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── TTS（Edge TTS，无需 API Key）──────────────────────────────────────────
# 可选：中文语音发音人，默认 zh-CN-XiaoxiaoNeural
# 其他选项：zh-CN-YunxiNeural（男声）、zh-CN-XiaoyiNeural 等
# TTS_VOICE=zh-CN-XiaoxiaoNeural

# ── 火山引擎数字人（字节跳动）─────────────────────────────────────────────
# 在火山引擎控制台 https://console.volcengine.com/iam/keymanage 获取
VOLCENGINE_ACCESS_KEY=your_access_key_here
VOLCENGINE_SECRET_KEY=your_secret_key_here
# 数字人形象 ID，在火山引擎数字人控制台创建后获取
VOLCENGINE_AVATAR_ID=your_avatar_id_here
# 地域，默认 cn-north-1
# VOLCENGINE_REGION=cn-north-1
